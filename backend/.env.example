# ============================================================
# MS Learn Video Documenter Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# See docs/AZURE-SETUP.md for provisioning instructions.
#
# AUTHENTICATION: This app uses DefaultAzureCredential (managed
# identity in production, az CLI / VS Code credential locally).
# No API keys or connection strings needed.
# ============================================================

# ============================================================
# QUICK START (local mode, no Azure required):
# Only these variables are needed for local-only processing:
#   PROCESSING_MODE=local
#   WHISPER_MODEL=base (or tiny for faster, lower quality)
#   FFMPEG_PATH=ffmpeg (must be on PATH, or full path)
#   OUTPUT_DIRECTORY=./output
# Everything else below is for cloud mode or advanced config.
# ============================================================

# --- Processing Mode ---
PROCESSING_MODE=local
# Change to 'cloud' after completing Azure setup (see docs/AZURE-SETUP.md)

# --- Environment ---
# Controls uvicorn reload and debug behavior
ENVIRONMENT=development

# --- Azure AI Foundry ---
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
FOUNDRY_MODEL=gpt-4o
FOUNDRY_MODEL_MINI=gpt-4o-mini

# --- Azure Blob Storage ---
# Account URL (NOT connection string — uses DefaultAzureCredential)
BLOB_ACCOUNT_URL=https://stvideodocumenter.blob.core.windows.net
BLOB_CONTAINER_NAME=video-documenter
# Hours before SAS tokens expire (default: 1)
BLOB_RETENTION_HOURS=1

# --- Azure AI Speech (cloud mode only) ---
# Endpoint URL (NOT API key — uses DefaultAzureCredential)
SPEECH_SERVICE_ENDPOINT=https://speech-video-documenter.cognitiveservices.azure.com
SPEECH_SERVICE_REGION=eastus

# --- Azure Video Indexer (cloud mode only) ---
# Uses DefaultAzureCredential to generate ARM access tokens
VIDEO_INDEXER_ACCOUNT_ID=
VIDEO_INDEXER_RESOURCE_ID=
VIDEO_INDEXER_LOCATION=trial

# --- Video Indexer Tuning (optional, defaults shown) ---
# Max wait time for indexing, poll frequency, and progress emission interval
# VI_INDEXING_TIMEOUT_S=1200
# VI_POLL_INTERVAL_S=15
# VI_PROGRESS_INTERVAL_S=30

# --- Local Mode Settings ---
WHISPER_MODEL=base
FFMPEG_PATH=ffmpeg

# --- Local Mode: Copilot LM Proxy ---
# When using the VS Code extension in local mode, the extension runs an LM Proxy
# that routes LLM calls through your GitHub Copilot subscription.
# The extension auto-configures this, but you can set it manually:
# COPILOT_PROXY_URL=http://localhost:3001
# COPILOT_PROXY_MODEL=copilot-auto
# COPILOT_PROXY_SECRET=
# Shared secret for Copilot proxy auth (auto-set by VS Code extension)

# --- Output ---
OUTPUT_DIRECTORY=./output

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# --- Feature Flags ---
ENABLE_YOUTUBE_DOWNLOAD=false
MAX_VIDEO_DURATION_MINUTES=15
MAX_VIDEO_SIZE_MB=2048
