# ============================================================
# MS Learn Video Documenter Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# See docs/AZURE-SETUP.md for provisioning instructions.
# ============================================================

# --- Processing Mode ---
# "cloud" = Azure Video Indexer + Speech (higher quality, requires Azure resources)
# "local" = FFmpeg + PySceneDetect + Whisper (free, runs offline)
PROCESSING_MODE=cloud

# --- Azure AI Foundry ---
# Required for all modes (provides LLM access)
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
FOUNDRY_MODEL=gpt-4o
FOUNDRY_MODEL_MINI=gpt-4o-mini

# --- Azure Blob Storage ---
# Required for cloud mode; optional for local mode
BLOB_CONNECTION_STRING=
BLOB_CONTAINER_NAME=video-documenter

# --- Azure AI Speech (cloud mode only) ---
SPEECH_SERVICE_KEY=
SPEECH_SERVICE_REGION=eastus

# --- Azure Video Indexer (cloud mode only) ---
VIDEO_INDEXER_ACCOUNT_ID=
VIDEO_INDEXER_RESOURCE_ID=
VIDEO_INDEXER_API_KEY=
VIDEO_INDEXER_LOCATION=trial

# --- Local Mode Settings ---
# Only used when PROCESSING_MODE=local
WHISPER_MODEL=base
FFMPEG_PATH=ffmpeg

# --- Output ---
OUTPUT_DIRECTORY=./output

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# --- Feature Flags ---
ENABLE_YOUTUBE_DOWNLOAD=false
MAX_VIDEO_DURATION_MINUTES=15
MAX_VIDEO_SIZE_MB=2048
