{
  "name": "mslearn-video-documenter",
  "displayName": "MS Learn Video Documenter",
  "description": "Analyzes screen recordings and generates MS Learn-style documentation",
  "version": "0.1.0",
  "publisher": "video-documenter",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "Chat"
  ],
  "activationEvents": [
    "onChatParticipant:video-documenter.agent"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "video-documenter.agent",
        "name": "video-documenter",
        "fullName": "MS Learn Video Documenter",
        "description": "Analyzes screen recordings and generates MS Learn documentation",
        "isSticky": true,
        "commands": [
          {
            "name": "analyze",
            "description": "Analyze a screen recording video"
          },
          {
            "name": "generate",
            "description": "Generate documentation from analyzed video"
          },
          {
            "name": "refine",
            "description": "Refine a section of generated documentation"
          },
          {
            "name": "save",
            "description": "Save generated document to a specific location"
          },
          {
            "name": "status",
            "description": "Check processing status"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "video-documenter.analyzeFile",
        "title": "Analyze with Video Documenter",
        "category": "Video Documenter"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "video-documenter.analyzeFile",
          "when": "resourceExtname =~ /\\.(mp4|avi|mov|mkv|webm)$/",
          "group": "video-documenter"
        }
      ]
    },
    "configuration": {
      "title": "MS Learn Video Documenter",
      "properties": {
        "video-documenter.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the Video Documenter backend server"
        },
        "video-documenter.outputDirectory": {
          "type": "string",
          "default": "docs",
          "description": "Workspace-relative directory for generated documentation output"
        },
        "video-documenter.autoOpenPreview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open markdown preview after generating a document"
        },
        "video-documenter.useCopilotModels": {
          "type": "boolean",
          "default": true,
          "description": "Use GitHub Copilot models for document generation in local mode (requires active Copilot subscription)"
        },
        "video-documenter.lmProxyPort": {
          "type": "number",
          "default": 0,
          "description": "Port for the LM Proxy server (0 = auto-assign). The proxy exposes Copilot models as an OpenAI-compatible API for the backend."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "mocha"
  },
  "ts-node": {
    "project": "./tsconfig.test.json",
    "transpileOnly": true
  },
  "dependencies": {
    "@vscode/chat-extension-utils": "^0.0.0-alpha.1",
    "@vscode/prompt-tsx": "^0.3.0-alpha.12"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.3",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
